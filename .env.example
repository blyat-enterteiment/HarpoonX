# Copy to .env locally; supply genuine dedicated PAPER credentials. Never commit .env.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
HARPOON_PANEL_PASSWORD=
HARPOON_DATA=./data/xxx
HARPOON_START_PAPER=1
# Default is automatic PAPER when omitted. Set 0 for an initial entry pause.
# SQLite RPC acknowledgement deadline in ms: integer 50..5000; default 2000.
HARPOON_STORAGE_TIMEOUT_MS=2000
HARPOON_PUBLIC_ORIGIN=http://127.0.0.1:10000
BIND_HOST=127.0.0.1
PORT=10000
# Windows: set PYTHON to python if python3 is not registered.
PYTHON=python3
# Optional futures connection. Genuine broker simulation credentials, not live.
IRONBEAM_USERNAME=
IRONBEAM_PASSWORD=
IRONBEAM_API_KEY=
IRONBEAM_ACCOUNT_ID=
# JSON array of actual dated contracts with verified lastTradeAt and firstNoticeAt when physical.
HARPOON_FUTURES_CONTRACTS=[]
HARPOON_FUTURES_PAPER_ORDERS=0
# Complete per-side commission plus exchange/clearing fees; blank blocks submission.
IRONBEAM_COMMISSION_PER_SIDE_USD=

# Shared quant worker. Model must be produced from verifiable observed data.
HARPOON_QUANT_PYTHON=python3
HARPOON_QUANT_MODEL=/var/data/quant_calibration.json
