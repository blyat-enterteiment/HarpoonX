{
  "name": "harpoon-xxxultimate",
  "services": {
    "xxxultimate": {
      "container_name": "harpoon-xxxultimate",
      "build": {"context": "${HX_APP_ROOT}", "dockerfile": "deploy/Dockerfile.xxx"},
      "init": true,
      "restart": "unless-stopped",
      "stop_grace_period": "60s",
      "read_only": true,
      "tmpfs": ["/tmp:rw,noexec,nosuid,size=256m"],
      "cap_drop": ["ALL"],
      "cap_add": ["CHOWN", "SETUID", "SETGID", "DAC_OVERRIDE"],
      "security_opt": ["no-new-privileges:true"],
      "mem_limit": "2g",
      "cpus": 2,
      "pids_limit": 256,
      "environment": {
        "HARPOON_DATA": "/var/data",
        "HARPOON_CONFIG": "/run/harpoon/config.json",
        "BIND_HOST": "0.0.0.0",
        "PORT": "10000",
        "PYTHON": "python3",
        "APCA_API_KEY_ID": null,
        "APCA_API_SECRET_KEY": null,
        "HARPOON_PANEL_PASSWORD": null,
        "HARPOON_START_PAPER": null,
        "HARPOON_PUBLIC_ORIGIN": null,
        "HARPOON_EXPECTED_ACCOUNT_ID": null,
        "HARPOON_STORAGE_TIMEOUT_MS": null,
        "HARPOON_QUANT_MODEL": null,
        "IRONBEAM_USERNAME": null,
        "IRONBEAM_PASSWORD": null,
        "IRONBEAM_API_KEY": null,
        "IRONBEAM_ACCOUNT_ID": null,
        "HARPOON_FUTURES_CONTRACTS": null,
        "HARPOON_FUTURES_PAPER_ORDERS": null,
        "IRONBEAM_COMMISSION_PER_SIDE_USD": null
      },
      "ports": [{"target": 10000, "published": "${HX_HOST_PORT}", "host_ip": "${HX_BIND_HOST}", "protocol": "tcp"}],
      "volumes": [
        {"type": "bind", "source": "${HX_DATA_PATH}", "target": "/var/data", "read_only": false, "bind": {"create_host_path": false}},
        {"type": "bind", "source": "${HX_CONFIG_PATH}", "target": "/run/harpoon/config.json", "read_only": true, "bind": {"create_host_path": false}}
      ],
      "labels": {"io.harpoon.runtime": "XXXUltimate", "io.harpoon.execution_mode": "paper"},
      "logging": {"driver": "json-file", "options": {"max-size": "10m", "max-file": "3"}},
      "healthcheck": {
        "test": ["CMD", "node", "-e", "fetch('http://127.0.0.1:10000/healthz',{signal:AbortSignal.timeout(3000)}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"],
        "interval": "30s", "timeout": "5s", "start_period": "60s", "retries": 3
      }
    }
  }
}
