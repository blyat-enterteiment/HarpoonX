{
  "name": "harpoon-cloud-247",
  "version": "30.16.0",
  "private": true,
  "scripts": {
    "test": "node tools/runtime_test.cjs && node tools/cloud_test.cjs && node tools/control_test.cjs && node tools/edge_test.cjs && python3 tools/install_test.py",
    "typecheck": "tsc --allowJs --checkJs --noEmit --skipLibCheck --target ES2022 --module node16 --types node runtime/control.cjs deploy/managed.cjs",
    "test:auth": "node tools/auth_security_test.cjs",
    "test:service": "python3 -m unittest discover -s service -p test_*.py",
    "verify:auth": "python3 tools/verify_auth.py",
    "test:xxv": "node tools/xxv_test.cjs",
    "test:agents": "node tools/agents25_test.cjs && node tools/agents25_integration.cjs",
    "typecheck:agents": "tsc --allowJs --checkJs --noEmit --skipLibCheck --target ES2022 --module node16 --types node src/agents25.js src/profit25.js src/vector25.js",
    "test:profit": "node tools/profit_vector25_test.cjs",
    "test:warroom": "node tools/warroom3_test.cjs && node tools/warroom3_integration.cjs",
    "test:warroom:cloud": "node tools/warroom3_cloud.cjs",
    "test:options": "node tools/options3_test.cjs",
    "test:autonomy": "node tools/autonomy3_test.cjs",
    "test:optimizer": "node tools/optimizer3_test.cjs",
    "test:warroom:browser": "node tools/warroom3_browser.cjs",
    "build:xxx": "tsc -p tsconfig.xxx.json",
    "start:ultimate": "node runtime30/server.js",
    "test:ultimate": "node --test tools/ultimate_test.cjs",
    "research:ultimate": "node research/ultimate/run.cjs",
    "test:ultimate:browser": "node tools/ultimate_browser.cjs",
    "verify:ultimate:production": "node tools/ultimate_production_check.cjs",
    "typecheck:xxx": "tsc -p tsconfig.xxx.json --noEmit",
    "start:xxx": "node runtime30/server.js",
    "test:xxx": "node --test tools/xxx_test.cjs tools/xxx_conformance_test.cjs tools/xxx_health_test.cjs tools/xxx_selector_test.cjs tools/xxx_tp32_test.cjs tools/xxx_operational_test.cjs tools/xxx_partial_entry_risk_test.cjs",
    "benchmark:xxx": "node tools/xxx_benchmark.cjs",
    "audit:xxx": "node tools/xxx_audit.cjs",
    "test:xxx:browser": "node tools/xxx_browser.cjs",
    "walkforward:xxx": "python3 research/tp32/prepare.py && node research/tp32/run.cjs && python3 research/tp32/metrics.py",
    "test:operational": "node --test tools/xxx_operational_test.cjs tools/xxx_operational_ui_contract.cjs",
    "test:operational:browser": "node tools/xxx_operational_browser.cjs",
    "test:quant": "node --no-use-env-proxy --require ./tools/quant_clock.cjs --test --test-isolation=none --test-timeout=30000 tools/quant_bridge_test.cjs",
    "test:svr": "node --no-use-env-proxy --require ./tools/quant_clock.cjs --test --test-isolation=none --test-timeout=30000 tools/quant_svr_integration_test.cjs",
    "test:xxx:clocked": "node --no-use-env-proxy --require ./tools/quant_clock.cjs --test --test-timeout=30000 tools/xxx_test.cjs tools/xxx_conformance_test.cjs tools/xxx_health_test.cjs tools/xxx_selector_test.cjs tools/xxx_tp32_test.cjs tools/xxx_operational_test.cjs tools/xxx_partial_entry_risk_test.cjs",
    "test:remediation": "python3 tools/verify_remediation.py --suite all",
    "evidence:level5": "node tools/level5_readiness.cjs",
    "test:storage": "node --test tools/store30_deadline_test.cjs",
    "evidence:collect": "node tools/collect_runtime_evidence.cjs",
    "test:evidence-collection": "node --test tools/collect_runtime_evidence_test.cjs",
    "evidence:level7": "python3 tools/level7_workflow.py",
    "test:forward-economics": "python3 -m unittest discover -s quant/tests -p test_forward_economics.py -v",
    "test:level7-workflow": "python3 -m unittest discover -s tools -p test_level7_workflow.py -v",
    "research:historical": "python3 tools/run_historical_bank.py",
    "test:historical": "python3 -m unittest discover -s tools -p test_historical_bank*.py -v"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@msgpack/msgpack": "3.1.2",
    "ws": "8.18.3"
  }
}
