+
+    def test_stricter_drawdown_boundary_reaches_allocator(self):
+        output = self.scenario({"drawdown_fraction": 0.001}, drawdown_fraction=0.002)
+        self.assertFalse(output["selected"])
+        self.assertFalse(output["execution_allowed"])
