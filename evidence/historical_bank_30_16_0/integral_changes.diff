+
+    def test_authority_budget_or_universe_escalation_is_rejected(self):
+        mutations = (("live_approved", True), ("independent_preregistration", True),
+                     ("universe", ["AAPL", "MSFT", "SPY", "XLK", "NVDA"]))
+        for field, value in mutations:
